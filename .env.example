# Google Gemini API Key (获取地址: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Azure Speech TTS（可选其一配置即可启用 azure provider）
# Key 获取：Azure Portal -> Speech resource -> Keys and Endpoint
# 注意：调用时 region 必须与 Key 所在区一致
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"

# Hono 后端服务端口
PORT=3001
