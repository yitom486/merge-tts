# Google Gemini API Key (获取地址: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Azure Speech TTS（可选其一配置即可启用 azure provider）
# Key 获取：Azure Portal -> Speech resource -> Keys and Endpoint
# 注意：调用时 region 必须与 Key 所在区一致
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"

# Local OpenAI-compatible server (Piper/Kokoro etc.); no key required for loopback services
LOCAL_TTS_ENDPOINT=""
LOCAL_TTS_MODEL=""
LOCAL_TTS_API_KEY=""
# Optional catalog override for servers without GET /v1/audio/voices
LOCAL_TTS_VOICES=""

# Hono 后端服务端口
PORT=3001
